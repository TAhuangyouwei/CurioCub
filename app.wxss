page {
  min-height: 100vh;
  color: #27445d;
  background: #eaf5ff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  box-sizing: border-box;
}

.tap-card {
  transition: transform 120ms ease;
}

.tap-card:active {
  transform: scale(0.98);
}
