@import "../../fonts/hanzi-kai.wxss";

.practice-screen { max-width: 760px; box-sizing: border-box; margin: 0 auto; padding: 24px 20px calc(24px + env(safe-area-inset-bottom)); }
.practice-eyebrow { display: block; color: #68819a; font-size: 14px; }
.practice-title { display: block; margin-top: 10px; color: #304c62; font-size: 26px; font-weight: 700; }
.practice-note { display: block; margin-top: 12px; color: #71849a; font-size: 15px; line-height: 1.7; }
.practice-progress { display: flex; justify-content: space-between; margin: 22px 0 10px; color: #71849a; font-size: 15px; }
.practice-card { display: flex; position: relative; min-height: 230px; box-sizing: border-box; padding: 16px 8px; flex-direction: column; align-items: center; justify-content: center; border-radius: 24px; background: #fffefa; }
.practice-character { color: #304c62; font-family: "CurioCubKai"; font-size: 136px; line-height: 1.15; font-weight: 400; }
.practice-pinyin { color: #68819a; font-size: 24px; }
.practice-hint { position: absolute; top: 12px; right: 12px; min-height: 44px; margin: 0; padding: 0 12px; border-radius: 14px; color: #8b7299; background: #f4edff; font-size: 15px; line-height: 44px; }
.practice-meaning { margin-top: 16px; color: #557087; font-size: 20px; }
.practice-primary, .practice-secondary { width: 100%; margin-top: 14px; border-radius: 18px; font-size: 18px; line-height: 2.7; font-weight: 600; }
.practice-primary { color: #fff; background: #5f83dd; }
.practice-primary.warm { color: #83502e; background: #ffdec1; }
.practice-secondary { color: #637e96; background: #e3edf7; }
.practice-finish { padding-top: 28px; text-align: center; }
.finish-icon { font-size: 56px; }
.reading-preview { display: block; margin: 24px 0; padding: 24px 12px; border-radius: 20px; color: #304c62; background: #fffefa; font-family: "CurioCubKai"; font-size: 38px; font-weight: 400; }
@media (min-width: 600px) { .practice-screen { padding-top: 36px; } .practice-card { min-height: 340px; } .practice-character { font-size: 190px; } }
