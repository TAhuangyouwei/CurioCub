@import "../../fonts/hanzi-kai.wxss";

.trace-screen { display: flex; flex-direction: column; box-sizing: border-box; padding: 12px 12px 0; overflow: hidden; }
.trace-meta { display: flex; flex: none; height: 40px; align-items: center; gap: 12px; margin-bottom: 4px; }
.trace-pinyin { color: #526f9a; font-size: 24px; font-weight: 700; }
.trace-phrase { flex: 1; min-width: 0; overflow: hidden; color: #557087; font-size: 16px; text-overflow: ellipsis; white-space: nowrap; }
.trace-count { color: #71849a; font-size: 14px; }
.trace-help { flex: none; height: 24px; color: #6a7f94; font-size: 14px; line-height: 24px; text-align: center; }
.trace-stage { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; }
.trace-board { position: relative; flex: none; overflow: hidden; border-radius: 12px; background: #fffefa; box-shadow: inset 0 0 0 2px #e4bbae; }
.grid-horizontal, .grid-vertical { position: absolute; pointer-events: none; }
.grid-horizontal { top: 50%; left: 0; right: 0; border-top: 1px dashed #e7c9c1; }
.grid-vertical { top: 0; bottom: 0; left: 50%; border-left: 1px dashed #e7c9c1; }
.trace-character { position: absolute; inset: 0; color: #c3cbd6; font-family: "CurioCubKai"; font-weight: 400; text-align: center; pointer-events: none; }
.trace-canvas { position: absolute; inset: 0; z-index: 1; display: block; width: 100%; height: 100%; touch-action: none; }
.trace-controls { flex: none; margin-top: 12px; }
.stroke-note { position: absolute; top: 8px; left: 12px; color: #71849a; font-size: 12px; pointer-events: none; }
.trace-guide-help { display: flex; flex: none; height: 44px; align-items: center; justify-content: space-between; gap: 8px; color: #6a7f94; font-size: 14px; }
.trace-screen .guide-play { flex: none; min-height: 44px; margin: 0; padding: 0 12px; color: #36866c; background: transparent; font-size: 14px; line-height: 44px; }
.stroke-origin { position: absolute; z-index: 2; width: 0; height: 0; pointer-events: none; }
.stroke-dot { position: absolute; left: -10px; top: -10px; width: 20px; height: 20px; border-radius: 50%; color: #fff; background: #279b73; font-size: 13px; font-weight: 700; line-height: 20px; text-align: center; box-shadow: 0 0 0 3px #ffffffcc; }
.stroke-arrow { position: absolute; left: 0; top: -2px; width: 42px; height: 4px; background: #279b73; transform-origin: 0 50%; }
.stroke-arrow::after { position: absolute; right: -1px; top: -4px; width: 0; height: 0; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 9px solid #279b73; content: ""; }
.stroke-demo { position: absolute; z-index: 3; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: #f6aa56; box-shadow: 0 0 0 5px #f6aa5640; pointer-events: none; }
.trace-actions { display: flex; gap: 12px; }
.character-actions { margin-top: 10px; }
.trace-action { flex: 1; height: 48px; margin: 0; padding: 0; border-radius: 14px; font-size: 18px; font-weight: 700; line-height: 48px; }
.trace-action.secondary { color: #526f9a; background: #e0eaff; }
.trace-action.restart { color: #99613c; background: #ffe6c6; }
.trace-action.primary { color: #fff; background: #5f83dd; }
.trace-action[disabled] { color: #a0aab7; background: #e9edf2; }
