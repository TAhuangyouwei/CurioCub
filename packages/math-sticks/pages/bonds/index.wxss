.number-screen { max-width: 640px; box-sizing: border-box; margin: 0 auto; padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); }
.number-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.number-title { color: #304c62; font-size: 23px; font-weight: 700; }
.question-count { flex: none; color: #8191a1; font-size: 13px; }
.limit-tabs { display: flex; gap: 10px; margin-top: 14px; }
.limit-tabs .limit-option { flex: 1; width: 0; min-width: 0; min-height: 44px; margin: 0; padding: 10px 8px; border-radius: 14px; color: #557087; background: #fff; font-size: 16px; line-height: 1.5; }
.limit-option.selected { color: #fff; background: #4cab92; }
.goal-card { margin-top: 14px; padding: 14px; border-radius: 20px; background: #fff8e4; text-align: center; }
.goal-title, .goal-description { display: block; }
.goal-title { color: #70562f; font-size: 21px; font-weight: 700; }
.goal-description { margin-top: 6px; color: #8f7a59; font-size: 13px; line-height: 1.5; }
.number-instruction { display: block; margin: 12px 0; color: #71849a; font-size: 13px; line-height: 1.5; }
.number-board { position: relative; width: 100%; max-width: 560px; margin: 0 auto; }
.basket-zone, .tray-zone { position: absolute; left: 0; width: 100%; box-sizing: border-box; border: 2px solid #b6ddc8; border-radius: 20px; background: #f4fcf7; }
.basket-zone { top: 0; }
.tray-zone { border-color: #d4ddec; background: #fff; }
.zone-label { display: block; padding: 10px 14px 0; color: #557087; font-size: 14px; font-weight: 600; }
.star-slot { position: absolute; width: 44px; height: 44px; box-sizing: border-box; border: 1px dashed #d6e7dc; border-radius: 12px; pointer-events: none; }
.fixed-star, .star-token { position: absolute; display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 12px; color: #eeb54d; font-size: 34px; line-height: 44px; }
.fixed-star { pointer-events: none; }
.star-token { z-index: 2; touch-action: none; }
.star-symbol { pointer-events: none; }
.star-token.added-star { color: #5f83dd; }
.star-token.dragging { z-index: 3; background: #ffffffdd; box-shadow: 0 4px 12px #4a615033; }
.number-feedback { min-height: 44px; box-sizing: border-box; padding: 12px 6px; color: #71849a; font-size: 14px; line-height: 1.6; text-align: center; }
.number-feedback.success { color: #278765; }
.number-feedback.try-again { color: #aa7138; }
.number-equation { display: block; margin-bottom: 4px; font-size: 26px; font-weight: 700; }
.number-actions { display: flex; gap: 12px; }
.number-actions .reset-button, .number-actions .next-button { flex: 1; width: 0; min-width: 0; min-height: 48px; margin: 0; padding: 11px 8px; border-radius: 14px; color: #526f9a; background: #e0eaff; font-size: 17px; font-weight: 700; line-height: 1.5; }
.number-actions .next-button { color: #fff; background: #4cab92; }
.number-actions .next-button[disabled] { color: #96a3b1; background: #e0e6ee; }
