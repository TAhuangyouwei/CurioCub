.number-screen { max-width: 640px; box-sizing: border-box; margin: 0 auto; padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); color: #304c62; }
.number-title { display: block; font-size: 24px; font-weight: 700; }
.page-intro, .instruction, .anchor-tip { display: block; color: #71849a; font-size: 13px; line-height: 1.6; }
.page-intro { margin-top: 6px; }
.stage-tabs, .limit-tabs, .number-actions { display: flex; gap: 8px; margin-top: 14px; }
.stage-tabs .stage-option, .limit-tabs .limit-option { flex: 1; min-width: 0; width: 0; min-height: 44px; margin: 0; padding: 10px 4px; border-radius: 12px; color: #557087; background: #fff; font-size: 14px; line-height: 24px; }
.stage-tabs .selected, .limit-tabs .selected { color: #fff; background: #4cab92; }
.number-picker { margin-top: 16px; font-size: 14px; }
.whole-choices { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin-top: 8px; }
.whole-choices .whole-choice, .answer-choices .number-choice { min-width: 0; width: 100%; min-height: 44px; margin: 0; padding: 0; border-radius: 12px; color: #557087; background: #fff; font-size: 22px; line-height: 44px; }
.whole-choices .chosen, .answer-choices .chosen { color: #fff; background: #5f83dd; }
.quantity-card { margin-top: 16px; padding: 18px 14px; border-radius: 20px; background: #fff; text-align: center; }
.card-heading { display: block; font-size: 19px; font-weight: 700; line-height: 1.5; }
.instruction { margin: 8px 0; }
.ten-frame { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; width: 100%; max-width: 260px; margin: 18px auto; }
.ten-frame .frame-cell { position: relative; box-sizing: border-box; width: 100%; height: 48px; min-height: 48px; margin: 0; padding: 0; border: 1px dashed #c6d9e7; border-radius: 8px; color: #e3a431; background: #f7fbff; font-size: 26px; line-height: 46px; }
.ten-frame .filled, .mini-cell.filled { border-style: solid; border-color: #e6c985; background: #fff8e4; }
.ten-frame .extra-five.filled, .mini-cell.extra-five.filled { border-color: #bacceb; color: #5f83dd; background: #edf3ff; }
.ten-frame .counted { box-shadow: inset 0 0 0 2px #4cab92; }
.count-label { position: absolute; right: 3px; bottom: 0; color: #304c62; font-size: 12px; line-height: 16px; }
.quantity-reading { display: block; margin-bottom: 8px; color: #34745e; font-size: 18px; font-weight: 600; line-height: 1.6; }
.lesson-heading { margin-top: 18px; text-align: center; }
.bond-diagram { display: flex; flex-direction: column; margin-top: 16px; }
.bond-whole { align-self: center; box-sizing: border-box; width: 100%; max-width: 280px; padding: 12px; border: 2px solid #9dcbb6; border-radius: 18px; background: #f2fbf6; text-align: center; }
.node-label { display: block; color: #557087; font-size: 14px; line-height: 1.5; }
.node-number { display: block; color: #34745e; font-size: 36px; font-weight: 700; line-height: 48px; }
.blank-number { width: 64px; margin: 6px auto; border: 2px dashed #5f83dd; border-radius: 10px; color: #5f83dd; background: #fff; }
.whole-dots { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 3px; max-width: 160px; margin: 8px auto 0; }
.mini-cell { height: 26px; box-sizing: border-box; border: 1px dashed #c6d9e7; border-radius: 4px; color: #e3a431; font-size: 20px; line-height: 24px; }
.whole-note { display: block; margin-top: 8px; color: #71849a; font-size: 12px; line-height: 1.5; }
.bond-branches { position: relative; flex: none; height: 0; padding-bottom: 10%; margin: 0 25%; }
.branch-left, .branch-right { position: absolute; top: 0; width: 50%; height: 0; border-bottom: 2px solid #9cb2bf; }
.branch-left { left: 0; transform: skewY(-22deg); transform-origin: top right; }
.branch-right { right: 0; transform: skewY(22deg); transform-origin: top left; }
.bond-parts { display: flex; align-items: stretch; gap: 12px; }
.bond-part { flex: 1; min-width: 0; box-sizing: border-box; padding: 12px 6px; border: 2px solid #e6c985; border-radius: 18px; background: #fff8e4; text-align: center; }
.right-part { border-color: #bacceb; background: #f1f6ff; }
.left-part .node-number { color: #a57420; }
.right-part .node-number { color: #5f83dd; }
.bond-part .blank-number { color: #5f83dd; }
.part-stars { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 6px; }
.part-stars .star-button, .hint-star { flex: none; width: 40px; min-height: 44px; height: 44px; margin: 0; padding: 0; border-radius: 10px; color: #dda233; background: transparent; font-size: 30px; line-height: 44px; }
.right-part .star-button, .right-part .hint-star { color: #5f83dd; }
.empty-part { color: #71849a; font-size: 12px; line-height: 44px; }
.composition .bond-whole { order: 3; }
.composition .bond-branches { order: 2; transform: rotate(180deg); }
.composition .bond-parts { order: 1; }
.reading-card { margin-top: 16px; padding: 14px; border-radius: 16px; color: #34745e; background: #e3f5ec; font-size: 17px; line-height: 1.7; text-align: center; }
.number-equation { display: block; font-size: 25px; font-weight: 700; }
.practice-controls { margin-top: 14px; }
.practice-controls .hint-button { min-height: 44px; margin: 0; color: #526f9a; background: #e0eaff; border-radius: 12px; font-size: 15px; line-height: 44px; }
.answer-choices { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; }
.number-screen .primary-button, .number-screen .secondary-button { min-height: 48px; margin: 14px 0 0; padding: 10px 8px; border-radius: 14px; color: #fff; background: #4cab92; font-size: 16px; font-weight: 700; line-height: 28px; }
.number-actions .primary-button, .number-actions .secondary-button { flex: 1; min-width: 0; width: 0; margin-top: 0; }
.number-screen .secondary-button { color: #526f9a; background: #e0eaff; }
.number-screen .primary-button[disabled] { color: #96a3b1; background: #e0e6ee; }
.number-feedback { margin-top: 14px; padding: 12px; border-radius: 12px; color: #70562f; background: #fff8e4; font-size: 15px; line-height: 1.7; text-align: center; }
.number-feedback.success { color: #278765; background: #e3f5ec; }
.parent-tip { margin-top: 20px; color: #8191a1; font-size: 12px; line-height: 1.7; }
@media (max-width: 360px) { .stage-tabs .stage-option { font-size: 12px; } .node-label { font-size: 13px; } .bond-parts { gap: 8px; } }
