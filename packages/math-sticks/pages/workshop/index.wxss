.workshop-screen { padding: calc(24 * var(--ui-unit)) calc(28 * var(--ui-unit)) calc(40 * var(--ui-unit)); padding-bottom: calc(calc(40 * var(--ui-unit)) + env(safe-area-inset-bottom)); }
.mode-tabs { display: flex; padding: calc(8 * var(--ui-unit)); border-radius: calc(26 * var(--ui-unit)); background: #fff; }
.mode-tab { flex: 1; width: 0; min-width: 0; margin: 0; padding: 0; border-radius: calc(21 * var(--ui-unit)); color: #668079; background: transparent; font-size: calc(28 * var(--ui-unit)); font-weight: 700; line-height: calc(80 * var(--ui-unit)); }
.mode-tab.selected { color: #fff; background: #57a68d; }
.equation-card { margin-top: calc(20 * var(--ui-unit)); padding: calc(18 * var(--ui-unit)); border: calc(2 * var(--ui-unit)) solid #d4eadf; border-radius: calc(28 * var(--ui-unit)); text-align: center; background: #f2fbf5; }
.equation-caption { display: block; color: #6b8a7b; font-size: calc(23 * var(--ui-unit)); }
.equation { display: block; margin-top: calc(4 * var(--ui-unit)); color: #34745e; font-size: calc(58 * var(--ui-unit)); line-height: 1.35; font-weight: 800; }
.instruction { display: block; margin: calc(20 * var(--ui-unit)) calc(2 * var(--ui-unit)); color: #597488; font-size: calc(24 * var(--ui-unit)); line-height: 1.5; }
.total-picker { display: flex; justify-content: space-between; align-items: center; margin-top: calc(18 * var(--ui-unit)); padding: calc(12 * var(--ui-unit)) calc(18 * var(--ui-unit)); border-radius: calc(22 * var(--ui-unit)); background: #fff; }
.picker-label, .picker-tip { display: block; }
.picker-label { color: #496d5b; font-size: calc(26 * var(--ui-unit)); font-weight: 700; }
.picker-tip { margin-top: calc(5 * var(--ui-unit)); color: #81928d; font-size: calc(20 * var(--ui-unit)); }
.stepper { display: flex; align-items: center; }
.step-button { width: calc(88 * var(--ui-unit)); height: calc(88 * var(--ui-unit)); margin: 0; padding: 0; border-radius: calc(22 * var(--ui-unit)); color: #397c65; background: #e7f5ed; font-size: calc(42 * var(--ui-unit)); line-height: calc(88 * var(--ui-unit)); }
.step-button[disabled] { color: #a6b6ad; background: #f2f6f3; }
.start-count { min-width: calc(65 * var(--ui-unit)); text-align: center; font-size: calc(34 * var(--ui-unit)); font-weight: 800; }
.sticks-board { position: relative; width: 100%; }
.drop-zone { position: absolute; box-sizing: border-box; border: 2px solid #b6ddc8; border-radius: 22px; background: #f1fbf4; }
.zone-b { border-color: #b6cde9; background: #f1f6ff; }
.zone-pool { border-color: #ead7b8; background: #fff9ef; }
.zone-heading { display: flex; justify-content: space-between; align-items: center; padding: 7px 14px 0; color: #4b7f64; font-size: 14px; font-weight: 700; }
.zone-b .zone-heading { color: #547da5; }
.zone-pool .zone-heading { color: #93774c; }
.zone-count { font-size: 14px; }
.zone-empty { position: absolute; top: 70px; width: 100%; color: #96a7a1; text-align: center; font-size: 13px; pointer-events: none; }
.stick-handle { position: absolute; z-index: 1; display: flex; align-items: center; justify-content: center; border-radius: 14px; }
.stick-handle.dragging { z-index: 3; background: rgba(255, 255, 255, 0.8); box-shadow: 0 4px 12px rgba(74, 97, 80, 0.18); }
.matchstick { position: relative; width: 9px; height: 38px; margin-top: 3px; border-radius: 5px; background: linear-gradient(90deg, #c78d48, #f4d296 45%, #dfaf6c); box-shadow: 1px 2px 2px rgba(129, 91, 38, 0.15); pointer-events: none; }
.match-head { position: absolute; top: -3px; left: -2px; width: 13px; height: 13px; border-radius: 7px 7px 5px 5px; background: #d5786a; }
.stick-a .match-head { background: #59a98a; }
.stick-b .match-head { background: #6e97d2; }
.workshop-footer { display: flex; justify-content: space-between; align-items: center; margin-top: calc(20 * var(--ui-unit)); }
.footer-tip { color: #7f95a2; font-size: calc(22 * var(--ui-unit)); }
.reset-button { width: calc(175 * var(--ui-unit)); margin: 0; padding: 0; border-radius: calc(24 * var(--ui-unit)); color: #fff; background: #6d8adb; font-size: calc(26 * var(--ui-unit)); line-height: calc(86 * var(--ui-unit)); }
