.builder-page { height: 100vh; }
.builder-content { padding: 22rpx 22rpx 64rpx; }

.builder-hero, .result-card, .keyboard-card, .mode-tabs {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 9rpx 22rpx rgba(80, 105, 140, 0.11);
}

.builder-hero {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: linear-gradient(135deg, #e7dcff, #fdf9ff);
}
.builder-hero-icon { display: flex; width: 70rpx; height: 70rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #8d76d4; font-size: 38rpx; font-weight: 800; }
.builder-title { display: block; color: #2c4560; font-size: 34rpx; font-weight: 800; }
.builder-subtitle, .spelling-tip, .privacy-note { display: block; color: #71849a; font-size: 21rpx; }
.builder-subtitle { margin-top: 4rpx; }

.mode-tabs { display: flex; gap: 8rpx; margin-top: 16rpx; padding: 8rpx; }
.mode-tab { width: 0; min-width: 0; flex: 1; margin: 0; padding: 0; border-radius: 20rpx; color: #697f95; background: transparent; font-size: 23rpx; font-weight: 700; line-height: 62rpx; }
.mode-tab-active { color: #fff; background: #6f8fe1; }

.result-card { margin: 16rpx 0; padding: 18rpx 22rpx; text-align: center; background: #f7f3ff; }
.result-ready { border: 2rpx solid #e7ddff; }
.result-empty { padding: 28rpx 22rpx; background: #fff8ed; }
.result-label { display: block; color: #74678e; font-size: 21rpx; }
.spelling-row { display: flex; align-items: center; justify-content: center; gap: 11rpx; margin: 7rpx 0 2rpx; color: #526b82; font-size: 34rpx; font-weight: 800; }
.plus { color: #9aa8b5; font-size: 26rpx; }
.arrow { color: #ef9b6a; }
.result-pinyin { color: #5d4c88; font-size: 50rpx; font-weight: 800; }
.result-character { color: #314f6c; font-size: 42rpx; font-weight: 800; }
.empty-tip { display: block; margin-top: 7rpx; color: #76889c; font-size: 20rpx; }

.keyboard-card { overflow: hidden; padding: 0; }
.key-section { padding: 18rpx 16rpx 20rpx; }
.key-section + .key-section { border-top: 8rpx solid #e9f2f2; }
.initial-section { background: #fff6e8; }
.final-section { background: #e9f8ff; }
.medial-section { background: #f2edff; }
.tone-section { background: #fff0f2; }
.whole-section { background: #f1edff; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13rpx; }
.section-title { color: #304b64; font-size: 27rpx; font-weight: 800; }
.section-count { color: #71869a; font-size: 20rpx; font-weight: 700; }

.option-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.sound-option, .tone-option, .whole-option { width: calc(12.5% - 7rpx); min-width: 0; box-sizing: border-box; flex: 0 0 calc(12.5% - 7rpx); margin: 0; padding: 0; border: 2rpx solid rgba(79, 101, 124, 0.13); border-radius: 14rpx; color: #38566e; font-size: 25rpx; font-weight: 800; line-height: 64rpx; box-shadow: inset 0 -4rpx 0 rgba(54, 75, 97, 0.08); }
.initial-option { background: #fffdf8; }
.final-option { background: #fafdff; }
.medial-option { background: #fbf9ff; }
.initial-selected { border-color: #ed963e; color: #fff; background: #ed963e; }
.final-selected { border-color: #278fc7; color: #fff; background: #278fc7; }
.medial-selected { border-color: #7c68ca; color: #fff; background: #7c68ca; }
.soft-unavailable { border-style: dashed; opacity: 0.55; }
.medial-grid { flex-wrap: nowrap; }
.medial-grid .sound-option { width: 0; flex: 1; }
.category-tip { display: block; margin-top: 12rpx; color: #668298; text-align: center; font-size: 18rpx; }

.tone-grid { display: flex; gap: 8rpx; }
.tone-option { display: flex; width: 0; height: 82rpx; flex: 1; flex-direction: column; align-items: center; justify-content: center; background: #fffafb; font-size: 18rpx; line-height: 1.15; }
.tone-mark { display: block; margin-bottom: 3rpx; font-size: 29rpx; }
.tone-selected { border-color: #de6d89; color: #fff; background: #de6d89; }
.option-disabled { color: #b9c2cc; background: #f1f3f5; box-shadow: none; opacity: 0.65; }

.read-button { margin-top: 20rpx; border-radius: 28rpx; color: #fff; background: #6389dd; font-size: 27rpx; font-weight: 800; line-height: 82rpx; }
.read-button[disabled] { color: #c6cfda; background: #e9edf2; }
.spelling-tip { margin: 12rpx 10rpx 0; color: #947c50; text-align: center; line-height: 1.5; }

.whole-result { padding: 24rpx 22rpx; }
.whole-pinyin { display: block; margin: 5rpx 0; }
.whole-keyboard { margin-top: 16rpx; }
.whole-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.whole-option { background: #fcfbff; font-size: 22rpx; }
.whole-selected { border-color: #806ccb; color: #fff; background: #806ccb; }
.privacy-note { margin: 16rpx 12rpx 0; text-align: center; line-height: 1.5; }
