.option-grid { display: flex; flex-wrap: wrap; gap: calc(8 * var(--ui-unit)); }
.sound-option, .tone-option, .whole-option { width: calc(12.5% - calc(7 * var(--ui-unit))); min-width: 0; box-sizing: border-box; flex: 0 0 calc(12.5% - calc(7 * var(--ui-unit))); margin: 0; padding: 0; border: calc(2 * var(--ui-unit)) solid rgba(79, 101, 124, 0.13); border-radius: calc(14 * var(--ui-unit)); color: #38566e; font-size: calc(25 * var(--ui-unit)); font-weight: 800; line-height: calc(64 * var(--ui-unit)); box-shadow: inset 0 calc(-4 * var(--ui-unit)) 0 rgba(54, 75, 97, 0.08); }
