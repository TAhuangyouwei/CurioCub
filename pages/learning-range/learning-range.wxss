.range-page { display: flex; flex-direction: column; box-sizing: border-box; height: 100vh; padding: 12px 12px 0; }
.range-header, .range-footer { flex: none; }
.range-heading { display: block; color: #27445d; font-size: 18px; font-weight: 700; }
.range-description { display: block; margin-top: 6px; color: #71849a; font-size: 13px; line-height: 1.5; }
.status-legend { display: flex; gap: 16px; padding: 10px 0; font-size: 12px; }
.unseen { color: #8391a0; }.learned { color: #278765; }.unlearned { color: #c17d30; }
.range-scroll { flex: 1; height: 0; min-height: 0; }
.range-grid { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; padding: 3px 0 12px; }
.range-cell { position: relative; display: flex; flex-direction: column; box-sizing: border-box; min-width: 0; height: 64px; align-items: center; justify-content: center; border: 2px solid transparent; border-radius: 9px; background: #fff; }
.cell-number { color: #8391a0; font-size: 10px; line-height: 14px; }
.cell-character { color: #304c62; font-size: 23px; line-height: 28px; }
.cell-state { font-size: 8px; line-height: 12px; }
.range-cell.in-range { background: #e0eaff; }
.range-cell.endpoint { border-color: #5f83dd; background: #d4e2ff; }
.cell-endpoint { position: absolute; right: -2px; top: -3px; padding: 1px 3px; border-radius: 5px; color: #fff; background: #5f83dd; font-size: 9px; }
.range-footer { padding: 12px 0 calc(12px + env(safe-area-inset-bottom)); background: #eaf5ff; }
.range-endpoints { display: flex; align-items: center; gap: 12px; }
.range-endpoints > view { flex: 1; min-width: 0; padding: 6px; border-radius: 12px; background: #fff; }
.selection-label { display: block; color: #71849a; font-size: 11px; text-align: center; }
.selection-arrow { flex: none; color: #71849a; }
.selection-summary, .selection-count { display: block; text-align: center; line-height: 1.5; }
.selection-summary { color: #304c62; font-size: 15px; font-weight: 700; }
.selection-count { margin-top: 4px; color: #71849a; font-size: 12px; }
.range-page .save-range { width: 100%; min-height: 48px; margin: 10px 0 0; padding: 11px 8px; border-radius: 14px; color: #fff; background: #5f83dd; font-size: 17px; line-height: 1.5; }
.save-range[disabled] { color: #96a3b1; background: #e0e6ee; }
@media (max-width: 360px) { .range-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
@media (min-width: 600px) { .range-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); } }
