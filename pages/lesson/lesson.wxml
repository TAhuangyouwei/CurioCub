<view class="screen lesson" wx:if="{{unit}}">
  <view class="custom-header">
    <button class="home-button tap-card" bindtap="returnToModule" aria-label="返回{{isNotebook ? '生字本' : module.title}}">‹</button>
    <view class="header-copy">
      <text class="module-chip" style="background: {{module.color}}">{{module.icon}} {{isNotebook ? '我的生字本' : module.title}}</text>
      <text class="card-count">第 {{currentNumber}} / {{cardTotal}} 张</text>
    </view>
    <text class="done-chip" wx:if="{{completed}}">{{isHanzi ? '已学会 ✓' : '已完成 ✓'}}</text>
    <text class="done-chip unlearned-chip" wx:elif="{{isHanzi && unlearned}}">未学会</text>
    <text class="done-chip unseen-chip" wx:elif="{{isHanzi}}">未学习</text>
  </view>

  <view class="lesson-practice">
  <swiper class="lesson-swiper" current="{{currentIndex}}" circular="{{rangeEnabled && lessonItems.length > 1}}" duration="260" bindchange="onCardChange">
    <swiper-item wx:for="{{lessonItems}}" wx:key="id">
      <view class="lesson-card">
        <block wx:if="{{isHanzi}}">
          <view
            wx:if="{{!hintVisible || item.id !== unit.id}}"
            class="hint-slot hint-button tap-card"
            catchtap="showHint"
            data-unit-id="{{item.id}}"
            role="button"
          >💡 提示</view>
          <image wx:else class="hint-slot scene-image" src="{{item.imageFile}}" mode="aspectFit" />
        </block>
        <text wx:else class="scene-icon">{{item.icon}}</text>
        <text class="big-symbol tap-card {{isHanzi ? 'hanzi-symbol' : ''}}" bindtap="playCardAudio">{{item.title}}</text>
        <text class="scene-phrase">{{item.phrase}}</text>
      </view>
    </swiper-item>
  </swiper>
  <text class="swipe-hint">{{rangeEnabled ? '← 左右滑动，只在设定范围内循环 →' : isNotebook ? '← 左右滑动，查看生字本里的字 →' : '← 左右滑动，切换已学和新字 →'}}</text>
  <button wx:if="{{isHanzi}}" class="trace-button tap-card" bindtap="openTrace">✍️ 大字临摹</button>
  </view>

  <view class="lesson-actions">
  <label wx:if="{{isHanzi}}" class="auto-read-setting"><text>换字自动朗读</text><switch checked="{{autoRead}}" bindchange="changeAutoRead" color="#5f83dd" /></label>
  <view class="listen-card">
    <view>
      <text class="listen-title">听一听，跟着读</text>
      <text class="listen-subtitle" wx:if="{{isHanzi}}">点击大字或下面按钮都能听发音</text>
      <text class="listen-subtitle" wx:else>点一下小喇叭，仔细听</text>
    </view>
    <text class="listen-bear">🐻</text>
  </view>

  <view class="audio-actions" wx:if="{{isHanzi}}">
    <button class="audio-button tap-card" bindtap="playCharacterAudio">🔊 听汉字</button>
    <button class="audio-button light tap-card" bindtap="playPhraseAudio">🔊 听词语</button>
  </view>
  <button wx:else class="audio-button main-audio tap-card" bindtap="playMainAudio">🔊 点这里听声音</button>

  <view class="lesson-tip">
    <text wx:if="{{isHanzi}}">{{completed ? '已学会 · 复习时忘记了，可以改为未学会。' : unlearned ? '未学会 · 已收进生字本，认识后再改为已学会。' : '未学习 · 还未确认掌握情况，先听一听、试一试。'}}</text>
    <text wx:else>✨ 学会了吗？Cubi 准备了一个小挑战。</text>
  </view>
  <view wx:if="{{isHanzi}}" class="learning-status" role="group" aria-label="当前学习状态">
    <button class="status-button unseen {{!completed && !unlearned ? 'selected' : ''}}" bindtap="markUnstudied" aria-pressed="{{!completed && !unlearned}}">未学习{{!completed && !unlearned ? ' ✓' : ''}}</button>
    <button class="status-button learned {{completed ? 'selected' : ''}}" bindtap="markLearned" aria-pressed="{{completed}}">已学会{{completed ? ' ✓' : ''}}</button>
    <button class="status-button unlearned {{unlearned ? 'selected' : ''}}" bindtap="markUnlearned" aria-pressed="{{unlearned}}">未学会{{unlearned ? ' ✓' : ''}}</button>
  </view>
  <button wx:else class="challenge-button" bindtap="startChallenge">去闯关</button>
  </view>
</view>
