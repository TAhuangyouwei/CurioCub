.lesson {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx 72rpx;
}

.custom-header { display: flex; min-height: 74rpx; align-items: center; justify-content: space-between; }
.home-button { width: 68rpx; height: 68rpx; margin: 0; padding: 0; border-radius: 34rpx; color: #46647e; background: #fff; font-size: 51rpx; font-weight: 400; line-height: 58rpx; box-shadow: 0 7rpx 16rpx rgba(80, 105, 140, 0.12); }
.header-copy { display: flex; flex: 1; align-items: center; gap: 12rpx; padding-left: 18rpx; }
.module-chip, .done-chip { padding: 10rpx 15rpx; border-radius: 20rpx; color: #fff; font-size: 21rpx; font-weight: 700; }
.done-chip { color: #4d8b79; background: #e3f6ed; }
.card-count { color: #71849a; font-size: 21rpx; }

.lesson-swiper { height: 470rpx; margin-top: 25rpx; }
.lesson-card {
  display: flex;
  position: relative;
  height: 450rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #fffefa, #f6eeff);
  box-shadow: 0 15rpx 32rpx rgba(94, 104, 149, 0.14);
}

.scene-icon { position: absolute; top: 30rpx; right: 35rpx; font-size: 68rpx; }
.hint-slot { position: absolute; top: 30rpx; right: 30rpx; display: flex; width: 112rpx; height: 112rpx; box-sizing: border-box; align-items: center; justify-content: center; }
.scene-image { padding: 4rpx; }
.hint-button { top: 40rpx; right: 40rpx; width: 92rpx; height: 92rpx; margin: 0; padding: 0; border: 2rpx solid #e1d9f6; border-radius: 20rpx; color: #766399; background: #f5f0ff; font-size: 21rpx; font-weight: 700; line-height: 1.2; }
.big-symbol { color: #304c62; font-size: 180rpx; line-height: 1.1; font-weight: 800; }
.scene-phrase { margin-top: 18rpx; color: #557087; font-size: 35rpx; font-weight: 700; }
.swipe-hint { display: block; margin: -3rpx 0 22rpx; color: #8191a1; text-align: center; font-size: 21rpx; }

.listen-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 25rpx;
  border-radius: 27rpx;
  background: #e9f7f0;
}
.listen-title { display: block; color: #305e54; font-size: 28rpx; font-weight: 800; }
.listen-subtitle { display: block; margin-top: 5rpx; color: #63847d; font-size: 22rpx; }
.listen-bear { font-size: 55rpx; }

.audio-actions { display: flex; gap: 18rpx; margin-top: 25rpx; }
.audio-button { flex: 1; margin: 0; border-radius: 28rpx; color: #fff; background: #5f83dd; font-size: 25rpx; font-weight: 700; }
.audio-button.light { color: #526f9a; background: #e8efff; }
.main-audio { display: block; width: 100%; margin-top: 25rpx; }

.lesson-tip { margin: 33rpx 0 16rpx; color: #6a7f94; text-align: center; font-size: 24rpx; }
.challenge-button { border-radius: 31rpx; color: #fff; background: #ec9a6e; font-size: 29rpx; font-weight: 800; }
.challenge-button[disabled] { color: #4d8b79; background: #e3f6ed; }
