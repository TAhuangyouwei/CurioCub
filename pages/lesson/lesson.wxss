  overflow: hidden;
  border-radius: calc(42 * var(--ui-unit));
  background: linear-gradient(145deg, #fffefa, #f6eeff);
  box-shadow: 0 calc(15 * var(--ui-unit)) calc(32 * var(--ui-unit)) rgba(94, 104, 149, 0.14);
}

.scene-icon { position: absolute; top: calc(30 * var(--ui-unit)); right: calc(35 * var(--ui-unit)); font-size: calc(68 * var(--ui-unit)); }
.hint-slot { position: absolute; top: calc(30 * var(--ui-unit)); right: calc(30 * var(--ui-unit)); display: flex; width: calc(112 * var(--ui-unit)); height: calc(112 * var(--ui-unit)); box-sizing: border-box; align-items: center; justify-content: center; }
.scene-image { padding: calc(4 * var(--ui-unit)); }
.hint-button { top: calc(40 * var(--ui-unit)); right: calc(40 * var(--ui-unit)); width: calc(92 * var(--ui-unit)); height: calc(92 * var(--ui-unit)); margin: 0; padding: 0; border: calc(2 * var(--ui-unit)) solid #e1d9f6; border-radius: calc(20 * var(--ui-unit)); color: #766399; background: #f5f0ff; font-size: calc(21 * var(--ui-unit)); font-weight: 700; line-height: 1.2; }
.big-symbol { color: #304c62; font-size: calc(180 * var(--ui-unit)); line-height: 1.1; font-weight: 800; }
.hanzi-symbol { font-family: "CurioCubKai"; font-weight: 400; }
.scene-phrase { margin-top: calc(18 * var(--ui-unit)); color: #557087; font-size: calc(35 * var(--ui-unit)); font-weight: 700; }
.swipe-hint { display: block; margin: calc(-3 * var(--ui-unit)) 0 calc(22 * var(--ui-unit)); color: #8191a1; text-align: center; font-size: calc(21 * var(--ui-unit)); }
.trace-button { margin: 0 0 calc(22 * var(--ui-unit)); border-radius: calc(28 * var(--ui-unit)); color: #99613c; background: #fff0d9; font-size: calc(29 * var(--ui-unit)); font-weight: 800; }

.listen-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(22 * var(--ui-unit)) calc(25 * var(--ui-unit));
  border-radius: calc(27 * var(--ui-unit));
  background: #e9f7f0;
}
.listen-title { display: block; color: #305e54; font-size: calc(28 * var(--ui-unit)); font-weight: 800; }
.listen-subtitle { display: block; margin-top: calc(5 * var(--ui-unit)); color: #63847d; font-size: calc(22 * var(--ui-unit)); }
.listen-bear { font-size: calc(55 * var(--ui-unit)); }

.audio-actions { display: flex; gap: calc(18 * var(--ui-unit)); margin-top: calc(25 * var(--ui-unit)); }
.audio-button { flex: 1; margin: 0; border-radius: calc(28 * var(--ui-unit)); color: #fff; background: #5f83dd; font-size: calc(25 * var(--ui-unit)); font-weight: 700; }
.audio-button.light { color: #526f9a; background: #e8efff; }
