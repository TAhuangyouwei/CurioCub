.lesson-tip { margin: calc(33 * var(--ui-unit)) 0 calc(16 * var(--ui-unit)); color: #6a7f94; text-align: center; font-size: calc(24 * var(--ui-unit)); }
.challenge-button { border-radius: calc(31 * var(--ui-unit)); color: #fff; background: #ec9a6e; font-size: calc(29 * var(--ui-unit)); font-weight: 800; }
.challenge-button.is-learned { color: #4d8b79; background: #e3f6ed; }
.unlearned-button { margin-top: calc(16 * var(--ui-unit)); border-radius: calc(31 * var(--ui-unit)); color: #a67438; background: #fff0db; font-size: calc(27 * var(--ui-unit)); font-weight: 700; }
