.lesson {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + calc(24 * var(--ui-unit))) calc(32 * var(--ui-unit)) calc(72 * var(--ui-unit));
}

.custom-header { display: flex; min-height: calc(74 * var(--ui-unit)); align-items: center; justify-content: space-between; }
.home-button { width: calc(68 * var(--ui-unit)); height: calc(68 * var(--ui-unit)); margin: 0; padding: 0; border-radius: calc(34 * var(--ui-unit)); color: #46647e; background: #fff; font-size: calc(51 * var(--ui-unit)); font-weight: 400; line-height: calc(58 * var(--ui-unit)); box-shadow: 0 calc(7 * var(--ui-unit)) calc(16 * var(--ui-unit)) rgba(80, 105, 140, 0.12); }
.header-copy { display: flex; flex: 1; align-items: center; gap: calc(12 * var(--ui-unit)); padding-left: calc(18 * var(--ui-unit)); }
.module-chip, .done-chip { padding: calc(10 * var(--ui-unit)) calc(15 * var(--ui-unit)); border-radius: calc(20 * var(--ui-unit)); color: #fff; font-size: calc(21 * var(--ui-unit)); font-weight: 700; }
.done-chip { color: #4d8b79; background: #e3f6ed; }
.unlearned-chip { color: #a67438; background: #fff0db; }
.card-count { color: #71849a; font-size: calc(21 * var(--ui-unit)); }

.lesson-swiper { height: calc(470 * var(--ui-unit)); margin-top: calc(25 * var(--ui-unit)); }
.lesson-card {
  display: flex;
  position: relative;
  height: calc(450 * var(--ui-unit));
  box-sizing: border-box;
