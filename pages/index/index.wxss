.home {
  height: 100vh;
}

.home-content {
  position: relative;
  overflow: hidden;
  padding: 42rpx 32rpx 72rpx;
}

.sky-orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.48;
  pointer-events: none;
}

.orb-one {
  top: 98rpx;
  right: -72rpx;
  width: 250rpx;
  height: 250rpx;
  background: #d7c8ff;
}

.orb-two {
  top: 480rpx;
  left: -96rpx;
  width: 220rpx;
  height: 220rpx;
  background: #bdeee0;
}

.hero,
.reward-row,
.section-heading,
.module-grid,
.gentle-note {
  position: relative;
  z-index: 1;
}

.hero {
  min-height: 318rpx;
  box-sizing: border-box;
  padding: 42rpx 28rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #b5e6fb, #d8cdff 76%);
  box-shadow: 0 18rpx 36rpx rgba(94, 110, 168, 0.18);
}

.hero-copy {
  width: 62%;
}

.eyebrow,
.section-subtitle,
.reward-label,
.module-subtitle,
.progress-copy {
  display: block;
  color: #5d6c83;
  font-size: 23rpx;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #45657f;
  font-weight: 600;
}

.hero-title {
  display: block;
  color: #27445d;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 800;
}

.mascot {
  position: absolute;
  right: 4rpx;
  bottom: 6rpx;
  width: 280rpx;
}

.continue-button {
  display: inline-flex;
  align-items: center;
  margin: 26rpx 0 0;
  padding: 0 26rpx;
  height: 66rpx;
  border-radius: 34rpx;
  color: #fff;
  background: #577fdd;
  font-size: 25rpx;
  line-height: 66rpx;
  font-weight: 700;
}

.reward-row {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0 44rpx;
}

.reward-card {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 15rpx;
  padding: 23rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 9rpx 22rpx rgba(80, 105, 140, 0.1);
}

.star-card { background: #fff9e5; }
.sticker-card { background: #fff0f2; }

.reward-icon { font-size: 47rpx; }

.reward-number,
.section-title,
.module-title {
  display: block;
  color: #27445d;
  font-weight: 800;
}

.reward-number { font-size: 31rpx; }
.reward-label { margin-top: 2rpx; font-size: 20rpx; }

.section-heading { margin-bottom: 22rpx; }
.section-title { font-size: 34rpx; }
.section-subtitle { margin-top: 7rpx; }

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.module-card {
  min-height: 244rpx;
  box-sizing: border-box;
  padding: 25rpx 22rpx 20rpx;
  border: 4rpx solid #edf1f7;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 20rpx rgba(80, 105, 140, 0.1);
}

.module-icon { margin-bottom: 8rpx; font-size: 54rpx; }
.module-title { font-size: 28rpx; }
.module-subtitle { margin: 6rpx 0 18rpx; font-size: 21rpx; }

.progress-track {
  height: 13rpx;
  overflow: hidden;
  border-radius: 9rpx;
  background: #e9eef4;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--card-color);
}

.progress-copy { margin-top: 9rpx; font-size: 19rpx; }

.gentle-note {
  padding-top: 48rpx;
  color: #71849a;
  text-align: center;
  font-size: 24rpx;
}
