.module-page { height: 100vh; }
.range-card { margin-bottom: calc(24 * var(--ui-unit)); padding: calc(24 * var(--ui-unit)); border-radius: calc(27 * var(--ui-unit)); background: #fffefa; }
.range-title, .range-summary { display: block; }
.range-title { color: #27445d; font-size: calc(30 * var(--ui-unit)); font-weight: 800; }
.range-summary { margin: calc(12 * var(--ui-unit)) 0; color: #71849a; font-size: calc(24 * var(--ui-unit)); }
.range-audio { display: flex; align-items: center; justify-content: space-between; color: #557087; font-size: calc(25 * var(--ui-unit)); }
.learning-counts { display: flex; flex-wrap: wrap; gap: calc(20 * var(--ui-unit)); margin: calc(12 * var(--ui-unit)) 0; font-size: calc(23 * var(--ui-unit)); }
.state-unseen, .unit-helper.state-unseen { color: #8391a0; }
.state-learned, .unit-helper.state-learned { color: #278765; }
.state-unlearned, .unit-helper.state-unlearned { color: #c17d30; }
.range-primary, .range-secondary, .range-exit { margin: calc(12 * var(--ui-unit)) 0 0; border-radius: calc(20 * var(--ui-unit)); font-size: calc(25 * var(--ui-unit)); }
.module-page .range-primary, .module-page .range-secondary, .module-page .range-exit { width: 100%; min-height: 44px; padding: 11px 14px; line-height: 1.5; }
.range-primary { color: #fff; background: #5f83dd; }
.range-secondary { color: #526f9a; background: #e8efff; }
.range-exit { color: #71849a; background: transparent; font-size: calc(23 * var(--ui-unit)); }

.module-content { padding: calc(30 * var(--ui-unit)) calc(28 * var(--ui-unit)) calc(72 * var(--ui-unit)); }

.module-hero {
  display: flex;
  position: relative;
  align-items: center;
  gap: calc(20 * var(--ui-unit));
  padding: calc(30 * var(--ui-unit)) calc(24 * var(--ui-unit));
  border-radius: calc(32 * var(--ui-unit));
  background: #fff;
  box-shadow: 0 calc(11 * var(--ui-unit)) calc(28 * var(--ui-unit)) rgba(80, 105, 140, 0.12);
  border-left: calc(12 * var(--ui-unit)) solid var(--module-color);
}

.module-hero-icon { font-size: calc(59 * var(--ui-unit)); }
.module-hero-title, .group-title, .unit-phrase { display: block; font-weight: 800; color: #27445d; }
.module-hero-title { font-size: calc(36 * var(--ui-unit)); }
.module-hero-subtitle, .group-progress, .unit-helper { display: block; color: #71849a; font-size: calc(23 * var(--ui-unit)); }
.module-hero-subtitle { margin-top: calc(6 * var(--ui-unit)); }

.star-pill {
  position: absolute;
  top: calc(22 * var(--ui-unit));
  right: calc(22 * var(--ui-unit));
  padding: calc(9 * var(--ui-unit)) calc(16 * var(--ui-unit));
  border-radius: calc(24 * var(--ui-unit));
  color: #735e26;
  background: #fff7d8;
  font-size: calc(23 * var(--ui-unit));
  font-weight: 700;
}

.tip-card {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--ui-unit));
  margin: calc(24 * var(--ui-unit)) 0;
  padding: calc(19 * var(--ui-unit)) calc(22 * var(--ui-unit));
  border-radius: calc(22 * var(--ui-unit));
  color: #47657c;
  background: #e5f5ed;
  font-size: calc(24 * var(--ui-unit));
  line-height: 1.45;
}
.tip-icon { font-size: calc(38 * var(--ui-unit)); }

.module-page .workshop-button {
  position: relative;
  width: 100%;
  display: block;
  line-height: 1.5;
  margin: 0 0 calc(24 * var(--ui-unit));
  padding: calc(24 * var(--ui-unit)) calc(70 * var(--ui-unit)) calc(24 * var(--ui-unit)) calc(25 * var(--ui-unit));
  border: 0;
  border-radius: calc(27 * var(--ui-unit));
  text-align: left;
  background: linear-gradient(135deg, #eee7ff, #fffaff);
  box-shadow: 0 calc(9 * var(--ui-unit)) calc(24 * var(--ui-unit)) rgba(106, 89, 169, 0.14);
}
.workshop-heading { display: flex; flex-wrap: wrap; align-items: center; gap: calc(14 * var(--ui-unit)); }
.workshop-count { flex: none; padding: calc(3 * var(--ui-unit)) calc(12 * var(--ui-unit)); border-radius: calc(16 * var(--ui-unit)); color: #765eb3; background: #e9e0fa; font-size: calc(21 * var(--ui-unit)); line-height: 1.5; }
.workshop-title, .workshop-subtitle { display: block; }
.workshop-title { color: #594582; font-size: calc(30 * var(--ui-unit)); font-weight: 800; }
.workshop-subtitle { margin-top: calc(8 * var(--ui-unit)); color: #7c7094; font-size: calc(22 * var(--ui-unit)); line-height: 1.6; }
.workshop-arrow { position: absolute; top: 50%; right: calc(26 * var(--ui-unit)); transform: translateY(-50%); color: #765eb3; font-size: calc(40 * var(--ui-unit)); }
.module-page .math-workshop { background: linear-gradient(135deg, #dff4e9, #f4fff8); }
.math-workshop .workshop-title, .math-workshop .workshop-arrow { color: #397c65; }
.math-workshop .workshop-subtitle { color: #5c8a78; }

.group-card {
  margin-bottom: calc(23 * var(--ui-unit));
  padding: calc(25 * var(--ui-unit)) calc(22 * var(--ui-unit));
  border-radius: calc(30 * var(--ui-unit));
  background: #fff;
  box-shadow: 0 calc(9 * var(--ui-unit)) calc(24 * var(--ui-unit)) rgba(80, 105, 140, 0.1);
}

.group-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: calc(17 * var(--ui-unit)); }
.group-title { font-size: calc(29 * var(--ui-unit)); }
.group-progress { margin-top: calc(4 * var(--ui-unit)); font-size: calc(21 * var(--ui-unit)); }
.group-state { padding: calc(8 * var(--ui-unit)) calc(13 * var(--ui-unit)); border-radius: calc(17 * var(--ui-unit)); color: #4b8979; background: #e5f5ed; font-size: calc(21 * var(--ui-unit)); font-weight: 700; }
.group-start { display: flex; align-items: center; min-height: 44px; box-sizing: border-box; }
.collapsible-header { min-height: 44px; }
.group-heading-actions { display: flex; align-items: center; gap: calc(14 * var(--ui-unit)); }
.group-toggle { flex: none; color: #526f9a; font-size: 13px; }
.group-preview { display: block; color: #557087; font-size: calc(34 * var(--ui-unit)); line-height: 1.8; letter-spacing: 1px; }
.group-card.outside-range { background: #e3e7ed; box-shadow: none; }
.outside-range .group-title, .outside-range .group-progress, .outside-range .group-preview { color: #929ca9; }
.outside-range .group-state { color: #8994a2; background: #d7dde6; }
.station-actions { display: flex; gap: 10px; margin-top: calc(22 * var(--ui-unit)); }
.module-page .station-learn-all, .module-page .station-actions .review-button { flex: 1; width: 0; min-width: 0; min-height: 44px; margin: 0; padding: 11px 8px; border-radius: calc(25 * var(--ui-unit)); font-size: calc(24 * var(--ui-unit)); font-weight: 700; line-height: 1.5; }
.station-learn-all { color: #278765; background: #e5f5ed; }
.station-learn-all[disabled] { color: #71849a; background: #edf3ef; }

.unit-list { border-top: calc(1 * var(--ui-unit)) solid #edf0f5; }
.unit-row { display: flex; align-items: center; min-height: calc(100 * var(--ui-unit)); border-bottom: calc(1 * var(--ui-unit)) solid #edf0f5; }
.unit-symbol { flex: none; width: calc(70 * var(--ui-unit)); color: #3b5267; font-size: calc(39 * var(--ui-unit)); font-weight: 800; text-align: center; }
.unit-copy { flex: 1; min-width: 0; padding: calc(10 * var(--ui-unit)) 0 calc(10 * var(--ui-unit)) calc(17 * var(--ui-unit)); line-height: 1.5; }
.unit-phrase { font-size: calc(26 * var(--ui-unit)); }
.unit-helper { margin-top: calc(2 * var(--ui-unit)); font-size: calc(20 * var(--ui-unit)); }
.unit-check, .unit-arrow { flex: none; width: calc(46 * var(--ui-unit)); color: #6d86a0; text-align: center; font-size: calc(29 * var(--ui-unit)); }
.unit-done .unit-symbol { color: #e49b3e; }

.module-page .review-button {
  width: 100%;
  min-height: 44px;
  padding: 11px 14px;
  line-height: 1.5;
  margin-top: calc(22 * var(--ui-unit));
  border-radius: calc(25 * var(--ui-unit));
  color: #fff;
  background: #7089df;
  font-size: calc(24 * var(--ui-unit));
  font-weight: 700;
}
