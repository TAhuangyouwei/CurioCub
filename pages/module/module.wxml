<scroll-view class="module-page" scroll-y wx:if="{{module}}">
  <view class="screen module-content">
    <view class="module-hero" style="--module-color: {{module.color}}">
      <view class="module-hero-icon">{{module.icon}}</view>
      <view>
        <text class="module-hero-title">{{module.title}}</text>
        <text class="module-hero-subtitle">{{module.subtitle}}</text>
      </view>
      <view class="star-pill">⭐ {{stars}}</view>
    </view>

    <view class="tip-card">
      <text class="tip-icon">🐻</text>
      <text>想学哪里就点哪里，也可以随时玩配对复习！</text>
    </view>

    <view wx:if="{{module.id === 'hanzi'}}" class="range-card">
      <text class="range-title">家长设置 · 学习范围</text>
      <text class="range-summary">{{rangeSummary}}</text>
      <view class="learning-counts"><text class="state-unseen">未学习 {{unseenCount}}</text><text class="state-learned">已学会 {{learnedCount}}</text><text class="state-unlearned">未学会 {{unlearnedCount}}</text></view>
      <label class="range-audio"><text>换字自动朗读</text><switch checked="{{autoRead}}" bindchange="changeAutoRead" color="#5f83dd" /></label>
      <button wx:if="{{rangeEnabled}}" class="range-primary" bindtap="startRangeLearning">开始学习</button>
      <button class="range-secondary" bindtap="editRange">{{rangeEnabled ? '修改范围' : '选择学习范围'}}</button>
      <button wx:if="{{rangeEnabled}}" class="range-exit" bindtap="exitLearningRange">退出范围，学习全部汉字</button>
    </view>

    <button wx:if="{{module.id === 'hanzi'}}" class="workshop-button" bindtap="openNotebook">
      <view class="workshop-heading"><text class="workshop-title">📖 生字本</text><text class="workshop-count">{{unlearnedCount}} 字</text></view>
      <text class="workshop-subtitle">把还没学会的字，集中练一练</text>
      <text class="workshop-arrow">›</text>
    </button>

    <button wx:if="{{module.id === 'pinyin'}}" class="workshop-button" bindtap="openPinyinWorkshop">
      <text class="workshop-title">♪ 拼读小工坊</text>
      <text class="workshop-subtitle">选声母、韵母和声调，听一听怎么拼</text>
      <text class="workshop-arrow">›</text>
    </button>

    <button wx:if="{{module.id === 'math'}}" class="workshop-button math-workshop" bindtap="openMathWorkshop">
      <text class="workshop-title">火柴棍小工坊</text>
      <text class="workshop-subtitle">拖一拖，练习数数和加减法</text>
      <text class="workshop-arrow">›</text>
    </button>

    <view wx:for="{{groups}}" wx:key="index" class="group-card">
      <view class="group-header">
        <view>
          <text class="group-title">第 {{item.number}} 站</text>
          <text class="group-progress">{{item.completed}} / {{item.total}} 已完成</text>
        </view>
        <text class="group-state" wx:if="{{item.complete}}">完成</text>
        <text class="group-state" wx:else>{{item.completed ? '进行中' : '随时开始'}}</text>
      </view>

      <view class="unit-list">
        <view
          wx:for="{{item.items}}"
          wx:for-item="unit"
          wx:key="id"
          class="unit-row tap-card {{unit.completed ? 'unit-done' : ''}}"
          bindtap="openLesson"
          data-unit-id="{{unit.id}}"
        >
          <view class="unit-symbol">{{unit.title}}</view>
          <view class="unit-copy">
            <text class="unit-phrase">{{unit.phrase}}</text>
            <text class="unit-helper state-learned" wx:if="{{module.id === 'hanzi' && unit.completed}}">已学会 ✓</text>
            <text class="unit-helper state-unlearned" wx:elif="{{module.id === 'hanzi' && unit.unlearned}}">未学会 · 已加入生字本</text>
            <text class="unit-helper state-unseen" wx:elif="{{module.id === 'hanzi'}}">未学习</text>
            <text class="unit-helper" wx:elif="{{unit.completed}}">已收集星星 ✓</text>
            <text class="unit-helper" wx:else>点击开始</text>
          </view>
          <text class="unit-check" wx:if="{{unit.completed}}">⭐</text>
          <text class="unit-arrow" wx:else>›</text>
        </view>
      </view>

      <button class="review-button" bindtap="openReview" data-group-index="{{item.index}}">配对复习</button>
    </view>
    <view wx:if="{{module.id === 'math'}}" class="group-card">
      <view class="group-header"><text class="group-title">第 3 站 · 随机计算</text><text class="group-state">10题一组</text></view>
      <text class="group-progress">选择加法或减法、设置范围，一页填写后统一检查。</text>
      <button class="review-button" bindtap="openMathPractice">开始随机练习</button>
    </view>
  </view>
</scroll-view>
